# ========================================================
# 悟堂·东方解忧处 —— AI 后台环境变量配置
# ========================================================

# 服务端口与地址
WUTANG_HOST=0.0.0.0
WUTANG_PORT=8000
WUTANG_DEBUG=false

# 大模型连接配置（支持任何 OpenAI 兼容协议接口）
# 示例 1: DeepSeek (推荐，性价比极高)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 示例 2: 阿里云百炼 (通义千问)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 示例 3: 本地部署 Ollama (私有化零外部调用)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# 示例 4: 智谱清言 (GLM-4)
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 生成参数
LLM_TIMEOUT=30.0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500

# 未配置 API Key 或网络离线时，是否自动启用高品质本地模拟流式打字机（开箱即用）
ENABLE_FALLBACK_STREAM=true
